# ==========================================================
# FASHION KAT — VARIABLES DE ENTORNO
# COPIA ESTE ARCHIVO COMO .env Y COMPLETA LOS VALORES
# NUNCA SUBAS EL ARCHIVO .env A UN REPOSITORIO PÚBLICO
# ==========================================================

# ---------- BASE DE DATOS ----------
# SQLITE (POR DEFECTO, NO REQUIERE INSTALACIÓN)
DATABASE_URL="file:./dev.db"
# PARA POSTGRESQL CAMBIA EL PROVIDER EN prisma/schema.prisma Y USA:
# DATABASE_URL="postgresql://usuario:clave@localhost:5432/fashionkat?schema=public"

# ---------- SEGURIDAD / SESIONES ----------
# CLAVE SECRETA PARA FIRMAR LOS TOKENS DE SESIÓN (MÍNIMO 32 CARACTERES)
# GENERA UNA CON: openssl rand -base64 48
AUTH_SECRET="cambia-esta-clave-por-una-larga-y-aleatoria-de-minimo-32-caracteres"

# URL PÚBLICA DEL SITIO (USADA EN SEO, SITEMAP, EMAILS Y PAGOS)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------- CONTACTO / WHATSAPP ----------
# NÚMERO DE WHATSAPP EN FORMATO INTERNACIONAL SIN "+" NI ESPACIOS. EJEMPLO: 573001112233
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_WHATSAPP_MESSAGE="HOLA, FASHION KAT. TENGO UNA PREGUNTA SOBRE UN PRODUCTO."

# ---------- CORREO ELECTRÓNICO (SMTP O RESEND) ----------
# SI ESTAS VARIABLES ESTÁN VACÍAS, LOS CORREOS SE REGISTRAN EN CONSOLA Y EN LA BASE DE DATOS
EMAIL_PROVIDER="log"          # log | smtp | resend
EMAIL_FROM="FASHION KAT <no-reply@fashionkat.co>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
RESEND_API_KEY=""

# ---------- PASARELAS DE PAGO ----------
# ACTIVA UNA DE: none | wompi | mercadopago | payu
PAYMENT_PROVIDER="none"

# WOMPI (COLOMBIA) — https://comercios.wompi.co
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
WOMPI_EVENTS_SECRET=""
WOMPI_INTEGRITY_SECRET=""
WOMPI_ENV="sandbox"           # sandbox | production

# MERCADO PAGO — https://www.mercadopago.com.co/developers
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_ACCESS_TOKEN=""

# PAYU LATAM — https://developers.payulatam.com
PAYU_MERCHANT_ID=""
PAYU_ACCOUNT_ID=""
PAYU_API_KEY=""
PAYU_API_LOGIN=""
PAYU_TEST="true"

# ---------- ALMACENAMIENTO DE IMÁGENES (OPCIONAL) ----------
# SI ESTÁ VACÍO, LAS IMÁGENES SE GUARDAN EN /public/uploads
STORAGE_PROVIDER="local"      # local | cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------- CUENTAS DE DEMOSTRACIÓN CREADAS POR LA SEMILLA ----------
SEED_ADMIN_EMAIL="admin@fashionkat.co"
SEED_ADMIN_PASSWORD="Admin123*"
SEED_CLIENT_EMAIL="cliente@fashionkat.co"
SEED_CLIENT_PASSWORD="Cliente123*"
